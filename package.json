{
  "name": "grbl-studio",
  "version": "0.7.0",
  "main": "dist/main/index.js",
  "author": "Vinicius Werneck",
  "license": "MIT",
  "description": "GRBL Studio - Modern LaserGRBL alternative for Linux",
  "scripts": {
    "build": "tsc && npm run build:preload && npm run build:worker && npm run build:materials && npm run build:machines && npm run build:adjust && npm run build:preview && npm run build:resume && npm run build:macros && npm run build:materialTest && npm run build:svg && npm run build:design && npm run build:designEditor && npm run build:fonts && npm run build:hatch && npm run build:contour && npm run build:boolean && npm run build:offset && npm run build:i18n && npm run build:qrcode && npm run build:barcode && npm run build:machine",
    "build:boolean": "esbuild src/shared/boolean.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_BOOLEAN --outfile=public/boolean.js",
    "build:offset": "esbuild src/shared/offset.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_OFFSET --outfile=public/offset.js",
    "build:contour": "esbuild src/shared/image/contour.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_CONTOUR --outfile=public/contour.js",
    "build:designEditor": "esbuild src/shared/designEditor.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_DESIGN_EDITOR --outfile=public/designEditor.js",
    "build:fonts": "esbuild src/shared/fonts.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_FONTS --outfile=public/fonts.js",
    "build:hatch": "esbuild src/shared/hatch.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_HATCH --outfile=public/hatch.js",
    "build:design": "esbuild src/shared/design.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_DESIGN --outfile=public/design.js",
    "build:materialTest": "esbuild src/shared/materialTest.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_MATERIAL_TEST --outfile=public/materialTest.js",
    "build:svg": "esbuild src/shared/svg.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_SVG --outfile=public/svg.js",
    "build:i18n": "esbuild src/shared/i18n/entry.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_I18N --outfile=public/i18n.js",
    "build:qrcode": "esbuild src/shared/symbol/entry.qr.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_QR --outfile=public/qrcode.js",
    "build:barcode": "esbuild src/shared/symbol/entry.barcode.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_BARCODE --outfile=public/barcode.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:worker": "esbuild src/renderer/gcode.worker.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=public/gcode.worker.js",
    "build:materials": "esbuild src/shared/materials.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_MATERIALS --outfile=public/materials.js",
    "build:machines": "esbuild src/shared/machines.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_MACHINES --outfile=public/machines.js",
    "probe": "node scripts/probe-machine.mjs",
    "grbl:send": "node scripts/grbl-send.mjs",
    "build:preview": "esbuild src/shared/preview.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_PREVIEW --outfile=public/preview.js",
    "build:resume": "esbuild src/shared/resume.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_RESUME --outfile=public/resume.js",
    "build:macros": "esbuild src/shared/macros.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_MACROS --outfile=public/macros.js",
    "dev": "tsc -w",
    "start": "electron .",
    "start:dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "smoke": "npm run build && GRBL_SMOKE_TEST=1 electron --no-sandbox .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "bench:preview": "xvfb-run -a node scripts/bench-preview.mjs",
    "package": "npm run build && electron-builder --publish never --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --publish never --config electron-builder.yml",
    "package:flatpak": "flatpak-builder --user --install --force-clean build-dir build/flatpak/com.grblstudio.app.yml",
    "build:adjust": "esbuild src/shared/image/adjust.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_ADJUST --outfile=public/adjust.js",
    "build:machine": "esbuild src/shared/entry.machine.ts --bundle --format=iife --platform=browser --target=es2022 --global-name=GRBL_MACHINE --outfile=public/machine.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@zxing/library": "^0.23.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
